{
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/applogs.txt",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl":  "http://localhost:5341"
        }
      }],
    "Enrich": ["FromLogContext", "WithThreadId", "WithMachineName"]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ShopConnection": "Server=localhost;Port=5432;Database=shopfull;User Id = postgres; Password=5456;",
    "HangfireDb": "hangfire.db"
  }
}
